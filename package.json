{
  "name": "ai-fight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI FIGHT — pixel-art arcade fighting game where a judge decides the winner of a debate",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite client\"",
    "prebuild": "node server/check-structure.js",
    "build": "vite build client",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
